{
  "name": "keryx-kit",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "conformance": "bun packages/domain/scripts/write-scenario.ts tmp/conformance && cd tools/conformance && go run . ../../tmp/conformance",
    "golden": "cd tools/conformance && go run ./golden ../../packages/domain/test/fixtures/go"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
